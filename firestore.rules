rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /kelas/{kelasId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /settings/{cmsId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
