rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /kelas/{kelasId} {
      allow read, write: if true;
    }

    match /settings/{cmsId} {
      allow read, write: if true;
    }

    match /testimonials/{id} {
      allow read, write: if true;
    }

    match /karya/{id} {
      allow read, write: if true;
    }

    match /tips/{id} {
      allow read, write: if true;
    }

    match /faqs/{id} {
      allow read, write: if true;
    }

    match /admins/{id} {
      allow read, write: if true;
    }
  }
}
